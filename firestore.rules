rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function email() { return request.auth.token.email.lower(); }
    function access() { return get(/databases/$(database)/documents/config/access).data; }
    function isOwner() {
      return request.auth != null && request.auth.token.email != null
        && access().owners.hasAny([email()]);
    }
    function isStaff() {
      return request.auth != null && request.auth.token.email != null
        && (access().owners.hasAny([email()]) || access().staff.hasAny([email()]));
    }

    /* รายชื่อผู้มีสิทธิ์: พนักงานอ่านได้ แก้ได้เฉพาะเจ้าของ (แนะนำให้แก้ใน Firebase Console) */
    match /config/access {
      allow read: if request.auth != null;
      allow write: if isOwner();
    }

    /* ราคา: ทุกคนที่เป็นพนักงานอ่านได้ แก้ได้เฉพาะเจ้าของ */
    match /settings/{doc} {
      allow read: if isStaff();
      allow write: if isOwner();
    }

    match /jobs/{id}      { allow read, write: if isStaff(); }
    match /customers/{id} { allow read, write: if isStaff(); }
    match /bookings/{id}  { allow read, write: if isStaff(); }

    /* บัญชี LINE ของลูกค้า: ให้เฉพาะ Cloud Functions จัดการ */
    match /lineUsers/{id} { allow read, write: if false; }
  }
}
